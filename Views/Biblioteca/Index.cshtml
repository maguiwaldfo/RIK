@* El link, la imagen y si cada teoría está bloqueada lo prepara BibliotecaController.Index *@

    <main class ="mapa-body">
        <div class="biblioteca-grid">
            @foreach (Teoria teoria in ViewBag.Teorias)
            {
                <a href="@teoria.Url" hidden="@teoria.EsBloqueada">
                    <div class="teoria">
                        <img src="@teoria.Imagen" alt="@teoria.Nombre" />
                        <h2>@teoria.Nombre</h2>
                    </div>
                </a>

                <div class="teoria teoria-bloqueada" hidden="@teoria.OcultarBloqueada">
                    <img src="/imagenes/candado.png" alt="Bloqueado" />
                    <h3>Próximamente</h3>
                </div>
            }

            <h2 hidden="@ViewBag.OcultarSinTeorias">TEORÍAS NO ENCONTRADAS</h2>
        </div>
    </main>
