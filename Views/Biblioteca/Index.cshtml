@{ var bd = new BD(); }

@foreach(Teoria teorias in bd.ObtenerTeorias())
{
    @if(!teorias.esBloqueada)
    {
        <a href= @Url.Action("Teoria", "Juego", "new { teoriaElegida = teoria.nombre }")>
            <div class="teoria">
                <img src="/imagenes/teoria/@teorias.nombreImagen" alt="@teorias.nombre" />
                <h2> @teorias.nombre</h2>
            </div>
        </a>
    }
    else
    {
        <a aria-disabled="true" href="@Url.Action("Teoria", "Juego", new { teoriaElegida = teoria.nombre })">
            <div class="teoria">
                <img src="/imagenes/teoria/@teorias.nombreImagen" alt="@teorias.nombre" />
                <h2>@teorias.nombre</h2>
                <h3>Proximamente</h3>
            </div>
        </a>
    }
}