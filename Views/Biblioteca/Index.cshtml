@{
    BD bd = new BD();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Inicio</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="mapa-body">
    <main>
        <div class="biblioteca-grid">

            @foreach (Teoria teoria in bd.ObtenerTeorias())
            {
                if (!teoria.esBloqueada)
               {
                    <a href="@Url.Action("Teoria", "Juego", new { idNivel = teoria.Id })">
                         <div class="teoria">
                            <img src="/imagenes/teoria/@teoria.nombreImagen" alt="@teoria.nombre" />
                            <h2>@teoria.nombre</h2>
                        </div>
                   </a>
                }
                else
                {
                    <div class="teoria teoria-bloqueada">
                        <img src="/imagenes/candado.png" alt="Bloqueado" />
                        <h3>Próximamente</h3>
                    </div>
                }
            }

        </div>
    </main>
    </body>
</html>
