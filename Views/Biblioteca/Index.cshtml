@{ var bd = new BD(); }

@foreach(Teoria teoria in bd.ObtenerTeorias())
{
    @if (!teoria.esBloqueada)
    {
        <a href="@Url.Action("Teoria", "Juego", new { teoriaElegida = teoria.nombre })">
            <div class="teoria">
                <img src="/imagenes/teoria/@teoria.nombreImagen" alt="@teoria.nombre" />
                <h2>@teoria.nombre</h2>
            </div>
        </a>
    }
    else
    {
        <a aria-disabled="true" href="@Url.Action("Teoria", "Juego", new { teoriaElegida = teoria.nombre })">
            <div class="teoria">
                <img src="/imagenes/teoria/@teoria.nombreImagen" alt="@teoria.nombre" />
                <h2>@teoria.nombre</h2>
                <h3>Proximamente</h3>
            </div>
        </a>
    }
}