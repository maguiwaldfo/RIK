<h1>Biblioteca</h1>

@foreach(Teoria teorias in bd.ObtenerTeorias())
{
    @if(teorias.esBloqueada == false)
    {
        @echo en caso de que este desbloqueada, se muestra la imagen, el nombre y es un link para acceder
        <a href="#" class="cta">
            <div class="teoria">
                <img src="@teorias.nombreImagen" alt="@teorias.nombre" />
                <h2>@teorias.nombre</h2>
            </div>
        </a>
    }
    else
    {
        @en caso de que este bloqueada se muestra un candado y la imagen blureada. todavia no existe la funcionalidad
        <a href="#" class="cta">
            <div class="teoria">
                <img src="@teorias.nombreImagen" alt="@teorias.nombre" />
                <h2>@teorias.nombre</h2>
            </div>
        </a>
    }
}