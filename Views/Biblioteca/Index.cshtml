@{
    ViewData["Title"] = "Biblioteca";
    List<RIK.Models.Teoria> teorias = (List<RIK.Models.Teoria>)ViewBag.Teorias;
}

<body class="mapa-body">
    <main>
        <div class="biblioteca-grid">
            @if (teorias != null)
            {
                @foreach (RIK.Models.Teoria teoria in teorias)
                {
                    if (!teoria.EsBloqueada)
                    {
                        <a href="@Url.Action("TeoriaMoraleja", "Biblioteca", new { idTeoria = teoria.Id })">
                            <div class="teoria">
                                <img src="/imagenes/teoria/@teoria.NombreImagen" alt="@teoria.Nombre" />
                                <h2>@teoria.Nombre</h2>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="teoria teoria-bloqueada">
                            <img src="/imagenes/candado.png" alt="Bloqueado" />
                            <h3>Próximamente</h3>
                        </div>
                    }
                }
            }
        </div>
    </main>
</body>