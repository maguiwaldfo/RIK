@* Los textos y qué se muestra (teoría, botón de iniciar o avisos) los prepara BibliotecaController.TeoriaMoraleja *@

<h1 hidden="@ViewBag.OcultarTeoria">@ViewBag.Titulo</h1>

<div hidden="@ViewBag.OcultarTeoria">
    <h2>@ViewBag.TituloTeoria</h2>
    <p>@ViewBag.TextoTeoria</p>
</div>

<div hidden="@ViewBag.OcultarTeoria">
    <h2>@ViewBag.TituloHistoria</h2>
    <p>@ViewBag.Historia</p>
</div>

<div hidden="@ViewBag.OcultarTeoria">
    <h2>Moraleja</h2>
    <p>@ViewBag.Moraleja</p>
</div>

<a href="@ViewBag.UrlIniciarNivel" hidden="@ViewBag.OcultarIniciarNivel">
    Iniciar nivel
</a>

<p hidden="@ViewBag.OcultarBloqueado">Nivel bloqueado. Completá el nivel anterior para desbloquearlo.</p>

<p hidden="@ViewBag.OcultarNoEncontrada">No se encontró la teoría seleccionada.</p>

<br />
<a href="@Url.Action("Index", "Biblioteca")">
    Volver
</a>
