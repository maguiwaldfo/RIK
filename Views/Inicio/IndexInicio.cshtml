@{

    List<int> nivelesCompletados = ViewBag.NivelesCompletados as List<int>;
    if (nivelesCompletados == null)
    {
        nivelesCompletados = new List<int>();
    }

    int maxNivelDesbloqueado = 1;
    if (ViewBag.MaxNivelDesbloqueado is int valorMaximo)
    {
        maxNivelDesbloqueado = valorMaximo;
    }

    double progresoNivel = Math.Min(1d, Math.Max(0d, (double)maxNivelDesbloqueado / 12d));
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Inicio</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="mapa-body">
    <main class="mapa-main">

        <div class="mapa-contenido">

            <!-- CAMINO DE NIVELES -->

   
<div class="camino-niveles">

    <svg class="lineas-camino"
         viewBox="0 0 1000 2100"
         preserveAspectRatio="none">

        <path class="camino-base"
              d="
              M 40 2000
              C 180 1940, 390 1880, 420 1740
              C 450 1600, 270 1530, 120 1480
              C -20 1430, 80 1280, 250 1250
              C 420 1220, 650 1300, 710 1150
              C 770 1000, 580 930, 420 880
              C 260 830, 290 680, 470 640
              C 650 600, 900 690, 940 530
              C 980 370, 780 320, 630 260
              C 480 200, 550 80, 730 40
              C 850 10, 950 -30, 1000 -100
              "
              fill="none"
              stroke="rgba(0,0,0,0.32)"
              stroke-width="7"
              stroke-linejoin="round"
              stroke-linecap="round" />

        <path class="camino-progreso"
              id="caminoProgreso"
              d="
              M 40 2000
              C 180 1940, 390 1880, 420 1740
              C 450 1600, 270 1530, 120 1480
              C -20 1430, 80 1280, 250 1250
              C 420 1220, 650 1300, 710 1150
              C 770 1000, 580 930, 420 880
              C 260 830, 290 680, 470 640
              C 650 600, 900 690, 940 530
              C 980 370, 780 320, 630 260
              C 480 200, 550 80, 730 40
              C 850 10, 950 -30, 1000 -100
              "
              fill="none"
              stroke="#064D2A"
              stroke-width="9"
              stroke-linejoin="round"
              stroke-linecap="round" />

    </svg>
</div>

              
@for (int nivel = 1; nivel <= 12; nivel++)
{
    bool estaCompletado = nivelesCompletados.Contains(nivel);
    bool estaDesbloqueado = nivel <= maxNivelDesbloqueado;

    string imagenMoneda = estaDesbloqueado
        ? "~/imagenes/monedaNivel.png"
        : "~/imagenes/monedaBloqueada.png";

    if (estaDesbloqueado && (estaCompletado || nivel == maxNivelDesbloqueado))
    {
       <a class="nodo nodo-desbloqueado nivel-@nivel"
        href="@Url.Action("Teoria", "Juego", new { idNivel = nivel })">

            <img src="@Url.Content(imagenMoneda)" alt="Nivel @nivel" />

        </a>
    }
    else
    {
    <div class="nodo nodo-bloqueado nivel-@nivel">
        <img src="@Url.Content(imagenMoneda)" alt="Nivel bloqueado" />
    </div>
    }
}

            <!-- BIBLIOTECA -->
<section class="mapa-biblioteca" style="width: 313px; height: 157px; background: #0A4D28; border-radius: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; box-sizing: border-box;">
    <p style="margin: 0; text-align: center; color: white; font-size: 20px; font-family: 'Poppins', sans-serif; font-weight: 400;">
        Repasá temas anteriores
    </p>

    <a href="@Url.Action("Index", "Biblioteca")" style="width: 229px; height: 46px; background: #FFEA00; border-radius: 10px; display: flex; align-items: center; justify-content: center; text-decoration: none; color: black; font-size: 20px; font-family: 'Poppins', sans-serif; font-weight: 400;">
        Ir a la biblioteca
    </a>
</section>


            <!-- RACHA -->

         <section class="mapa-racha" style="width: 132px; height: 132px; background: #0A4D28; border-radius: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; box-sizing: border-box;">
    <div class="racha-fuego" style="font-size: 54px; line-height: 1;">🔥</div>
    <p style="margin: 0; color: white; font-size: 24px; font-family: 'Poppins', sans-serif; font-weight: 400; line-height: 1.1;">
        @nivelesCompletados.Count
    </p>
    <small style="color: rgba(255, 255, 255, 0.85); font-size: 10px; font-family: 'Poppins', sans-serif; font-weight: 400;">
        Días de racha
    </small>
</section>

            <!-- DESEMPEÑO -->

            <section class="mapa-desempeno">
    <h2 style="font-family: 'Poppins', sans-serif; color: #0A4D28; font-size: 24px; font-weight: 600; margin-bottom: 12px;">
        Desempeño
    </h2>

    <div class="desempeno-tarjeta" style="width: 423px; height: 182px; background: #0A4D28; border-radius: 20px; display: flex; justify-content: space-around; align-items: center; padding: 0 20px; box-sizing: border-box;">

        <div style="width: 105px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px;">
            <div class="trofeo" style="font-size: 52px; line-height: 1;">🏆</div>
            <p style="margin: 0; color: white; font-size: 11px; font-family: 'Poppins', sans-serif; font-weight: 400; line-height: 1.3;">
                @nivelesCompletados.Count niveles completados
            </p>
        </div>

        <div style="width: 105px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px;">
            <div class="trofeo" style="font-size: 52px; line-height: 1;">🏆</div>
            <p style="margin: 0; color: white; font-size: 11px; font-family: 'Poppins', sans-serif; font-weight: 400; line-height: 1.3;">
                Trofeo de amigos
            </p>
        </div>

        <div style="width: 105px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px;">
            <div class="trofeo" style="font-size: 52px; line-height: 1;">🏆</div>
            <p style="margin: 0; color: white; font-size: 11px; font-family: 'Poppins', sans-serif; font-weight: 400; line-height: 1.3;">
                +90% respuestas acertadas
            </p>
        </div>

    </div>
</section>


            <!-- MASCOTA -->
            <div class="mapa-mascota">
                <img src="~/imagenes/rik-Landingprincipal.png" alt="Mascota de RIK" />
            </div>

        </div>

    </main>


</body>
</html>
