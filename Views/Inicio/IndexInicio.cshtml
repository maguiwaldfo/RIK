
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Inicio</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="mapa-body">

    <header class="mapa-header">
        <div class="mapa-marca">
            <div class="mapa-logo">R</div>
            <h1>RIK</h1>
        </div>

        <nav class="mapa-nav">
            <a href="@Url.Action("Index", "Home")">Inicio</a>
            <a href="#">Liga</a>
            <a href="#">Perfil</a>
        </nav>

        <a href="#" class="mapa-perfil">👤</a>
    </header>

    <main class="mapa-main">

        <div class="mapa-contenido">

            <!-- CAMINO DE NIVELES -->

            <div class="camino-niveles">

                <svg class="lineas-camino"
                     viewBox="0 0 1000 1400"
                     preserveAspectRatio="none">
                    <polyline
                        points="150,100 330,220 500,340 690,460
                                820,580 650,700 440,820 240,940
                                130,1060 340,1160 570,1260 800,1360"
                        fill="none"
                        stroke="black"
                        stroke-width="7"
                        stroke-linejoin="round" />
                </svg>

                <a class="nodo nivel-1"
                   href="@Url.Action("Teoria", "Juego", new { teoriaElegida = "Primeros pasos" })">
                    <div class="nodo-disponible">1</div>
                </a>

                <div class="nodo nivel-2">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-3">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-4">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-5">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-6">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-7">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-8">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-9">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-10">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-11">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

                <div class="nodo nivel-12">
                    <div class="nodo-bloqueado">🔒</div>
                </div>

            </div>

            <!-- BIBLIOTECA -->

            <section class="mapa-biblioteca">
                <p>Repasá temas anteriores</p>

                <a href="@Url.Action("Index", "Biblioteca")">
                    Ir a la biblioteca
                </a>
            </section>

            <!-- RACHA -->

            <section class="mapa-racha">
                <div class="racha-fuego">🔥</div>
                <p>0</p>
                <small>Días de racha</small>
            </section>

            <!-- DESEMPEÑO -->

            <section class="mapa-desempeno">
                <h2>Desempeño</h2>

                <div class="desempeno-tarjeta">

                    <div>
                        <div class="trofeo">🏆</div>
                        <p>30 respuestas seguidas</p>
                    </div>

                    <div>
                        <div class="trofeo">🏆</div>
                        <p>Trofeo de amigos</p>
                    </div>

                    <div>
                        <div class="trofeo">🏆</div>
                        <p>90% de respuestas acertadas</p>
                    </div>

                </div>
            </section>

            <!-- MASCOTA -->
            <!-- Agregar acá la imagen del perro de RIK -->

        </div>

    </main>

</body>
</html>
