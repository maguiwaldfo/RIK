@{
    ViewData["ClaseBody"] = "pagina-mapa";
}

@* El camino y cada moneda (posición, imagen, link o bloqueada) los prepara InicioController.IndexInicio *@

<div class="inicio-mapa" id="inicioMapa">

    <!-- CAPA QUE SE MUEVE: CAMINO Y NIVELES -->
    <div class="inicio-lienzo" id="inicioLienzo" style="@ViewBag.TamanoLienzo">

        <svg class="inicio-camino"
             viewBox="@ViewBag.ViewBoxCamino"
             preserveAspectRatio="none"
             aria-hidden="true">
            <path d="@ViewBag.Camino" />
        </svg>

        @* Las monedas sin link (Url = null) no se pueden abrir *@
        @foreach (NodoMapa nodo in ViewBag.Nodos)
        {
            <a class="@nodo.Clase" style="@nodo.Estilo" href="@nodo.Url">
                <img src="@nodo.Imagen" alt="@nodo.Alt" />
            </a>
        }
    </div>

    <!-- PANELES Y MASCOTA (QUEDAN FIJOS) -->
    <div class="inicio-pantalla">

        <section class="inicio-biblioteca card">
            <p>Repasá temas anteriores</p>
            <a href="@Url.Action("Index", "Biblioteca")">Ir a la biblioteca</a>
        </section>

        <section class="inicio-racha card">
            <img src="~/imagenes/llama.png" alt="Racha" />
            <p>@ViewBag.Racha</p>
        </section>

        <section class="inicio-desempeno">
            <h2>Desempeño</h2>
            <div class="inicio-desempeno-tarjeta card">
                <div class="inicio-trofeo">
                    <img src="~/imagenes/trofeo.png" alt="" />
                    <p>@ViewBag.CantidadCompletados niveles completados</p>
                </div>
                <div class="inicio-trofeo">
                    <img src="~/imagenes/trofeo.png" alt="" />
                    <p>Trofeo de amigos</p>
                </div>
                <div class="inicio-trofeo">
                    <img src="~/imagenes/trofeo.png" alt="" />
                    <p>+90% respuestas acertadas</p>
                </div>
            </div>
        </section>

        <div class="inicio-mascota">
            <img src="~/imagenes/rik-Landingprincipal.png" alt="Mascota de RIK" />
        </div>

    </div>
</div>

<script src="~/js/inicio.js"></script>
