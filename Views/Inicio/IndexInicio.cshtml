@{
    ViewData["Title"] = "Inicio";

    List<int> nivelesCompletados = ViewBag.NivelesCompletados as List<int>;
    if (nivelesCompletados == null)
    {
        nivelesCompletados = new List<int>();
    }

    int maxNivelDesbloqueado = 1;
    if (ViewBag.MaxNivelDesbloqueado is int valorMaximo)
    {
        maxNivelDesbloqueado = valorMaximo;
    }

    // Cantidad de niveles del mapa. Si se agregan niveles, alcanza con cambiar este número
    // (o mandar ViewBag.TotalNiveles desde el controller): el camino se alarga solo.
    int totalNiveles = 12;
    if (ViewBag.TotalNiveles is int valorTotal && valorTotal > 0)
    {
        totalNiveles = valorTotal;
    }

    // ---- ARMADO DEL CAMINO ----
    // Unidades: 1000 = ancho (o alto) de la pantalla. "y" negativa = hacia arriba.

    // Primeros 5 niveles: son los de la primera pantalla del diseño.
    var puntos = new List<int[]>
    {
        new[] { 92, -187 },
        new[] { 283, -474 },
        new[] { 513, -655 },
        new[] { 738, -772 },
        new[] { 934, -836 }
    };

    var camino = new System.Text.StringBuilder();
    camino.Append("M -30 -360 C 20 -310, 60 -250, 92 -187 ");
    camino.Append("C 110 -390, 120 -520, 195 -542 C 240 -554, 262 -510, 283 -474 ");
    camino.Append("C 330 -390, 400 -290, 445 -360 C 485 -425, 470 -580, 513 -655 ");
    camino.Append("C 560 -600, 640 -470, 685 -520 C 720 -560, 700 -700, 738 -772 ");
    camino.Append("C 790 -715, 850 -700, 885 -750 C 905 -780, 915 -810, 934 -836 ");

    // Del nivel 6 en adelante se van usando estos tramos, uno distinto por nivel
    // (recién se repiten cada 7 niveles). Cada tramo son dos curvas, con sus puntos
    // medidos desde la moneda anterior; los dos últimos números son la moneda siguiente.
    int[][] tramos = new int[][]
    {
        new[] { 26, -124, 106, -204, 141, -154,   161, -129, 176, -114, 196, -104 },
        new[] { 50, 30, 100, 120, 160, 50,        210, -10, 210, -140, 260, -200 },
        new[] { 60, 20, 110, -10, 120, -80,       128, -130, 135, -180, 150, -220 },
        new[] { 40, -100, 140, -140, 190, -100,   220, -80, 240, -65, 260, -50 },
        new[] { 40, 30, 90, 50, 115, -10,         145, -80, 130, -170, 160, -230 },
        new[] { 50, -80, 120, -60, 160, -10,      200, 40, 240, -20, 270, -70 },
        new[] { 40, -60, 60, -30, 100, -50,       150, -75, 160, -140, 190, -180 }
    };

    for (int nivel = 6; nivel <= totalNiveles; nivel++)
    {
        int[] desde = puntos[puntos.Count - 1];
        int[] t = tramos[(nivel - 6) % tramos.Length];

        camino.Append($"C {desde[0] + t[0]} {desde[1] + t[1]}, {desde[0] + t[2]} {desde[1] + t[3]}, {desde[0] + t[4]} {desde[1] + t[5]} ");
        camino.Append($"C {desde[0] + t[6]} {desde[1] + t[7]}, {desde[0] + t[8]} {desde[1] + t[9]}, {desde[0] + t[10]} {desde[1] + t[11]} ");

        puntos.Add(new[] { desde[0] + t[10], desde[1] + t[11] });
    }

    // Después de la última moneda el camino sigue un poco y sale de la pantalla.
    int[] ultimo = puntos[Math.Min(totalNiveles, puntos.Count) - 1];
    if (totalNiveles >= 5)
    {
        camino.Append($"C {ultimo[0] + 50} {ultimo[1] - 60}, {ultimo[0] + 120} {ultimo[1] - 50}, {ultimo[0] + 170} {ultimo[1] - 110} ");
        camino.Append($"C {ultimo[0] + 190} {ultimo[1] - 140}, {ultimo[0] + 210} {ultimo[1] - 170}, {ultimo[0] + 230} {ultimo[1] - 200}");
    }

    // Tamaño de la capa que se mueve: crece con la cantidad de niveles.
    int anchoCamino = Math.Max(1000, ultimo[0] + 180);
    int altoCamino = Math.Max(1000, -ultimo[1] + 110);

    var cultura = System.Globalization.CultureInfo.InvariantCulture;
    string tamanoLienzo = $"width: {(anchoCamino / 10.0).ToString("0.##", cultura)}%; height: {(altoCamino / 10.0).ToString("0.##", cultura)}%;";
}

<div class="inicio-mapa" id="inicioMapa">

    <!-- CAPA QUE SE MUEVE: CAMINO Y NIVELES -->
    <div class="inicio-lienzo" id="inicioLienzo" style="@tamanoLienzo">

        <svg class="inicio-camino"
             viewBox="0 -@altoCamino @anchoCamino @altoCamino"
             preserveAspectRatio="none"
             aria-hidden="true">
            <path d="@camino" />
        </svg>

        @for (int nivel = 1; nivel <= totalNiveles; nivel++)
        {
            bool estaCompletado = nivelesCompletados.Contains(nivel);
            bool estaDesbloqueado = nivel <= maxNivelDesbloqueado;

            string izquierda = (puntos[nivel - 1][0] * 100.0 / anchoCamino).ToString("0.##", cultura);
            string arriba = ((altoCamino + puntos[nivel - 1][1]) * 100.0 / altoCamino).ToString("0.##", cultura);
            string posicion = $"left: {izquierda}%; top: {arriba}%;";

            if (estaDesbloqueado && (estaCompletado || nivel == maxNivelDesbloqueado))
            {
                <a class="inicio-nodo inicio-nodo-desbloqueado @(nivel == maxNivelDesbloqueado ? "inicio-nodo-actual" : "")"
                   style="@posicion"
                   href="@Url.Action("Teoria", "Juego", new { idNivel = nivel })">
                    <img src="@Url.Content("~/imagenes/monedaNivel.png")" alt="Nivel @nivel" />
                </a>
            }
            else
            {
                string imagenMoneda = estaDesbloqueado
                    ? "~/imagenes/monedaNivel.png"
                    : "~/imagenes/monedaBloqueada.png";

                <div class="inicio-nodo @(estaDesbloqueado ? "" : "inicio-nodo-bloqueado")" style="@posicion">
                    <img src="@Url.Content(imagenMoneda)" alt="Nivel bloqueado" />
                </div>
            }
        }
    </div>

    <!-- PANELES Y MASCOTA (QUEDAN FIJOS) -->
    <div class="inicio-pantalla">

        <section class="inicio-biblioteca">
            <p>Repasá temas anteriores</p>
            <a href="@Url.Action("Index", "Biblioteca")">Ir a la biblioteca</a>
        </section>

        <section class="inicio-racha">
            <img src="~/imagenes/llama.png" alt="Racha" />
            <p>@nivelesCompletados.Count</p>
        </section>

        <section class="inicio-desempeno">
            <h2>Desempeño</h2>
            <div class="inicio-desempeno-tarjeta">
                <div class="inicio-trofeo">
                    <img src="~/imagenes/trofeo.png" alt="" />
                    <p>@nivelesCompletados.Count niveles completados</p>
                </div>
                <div class="inicio-trofeo">
                    <img src="~/imagenes/trofeo.png" alt="" />
                    <p>Trofeo de amigos</p>
                </div>
                <div class="inicio-trofeo">
                    <img src="~/imagenes/trofeo.png" alt="" />
                    <p>+90% respuestas acertadas</p>
                </div>
            </div>
        </section>

        <div class="inicio-mascota">
            <img src="~/imagenes/rik-Landingprincipal.png" alt="Mascota de RIK" />
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var mapa = document.getElementById('inicioMapa');
            var lienzo = document.getElementById('inicioLienzo');
            if (!mapa || !lienzo) return;

            var avance = 0;           // 0 = inicio del camino, 1 = final
            var arrastre = null;      // datos del arrastre en curso
            var huboArrastre = false; // para no abrir un nivel al soltar un arrastre

            // El camino sube en diagonal: al avanzar, la línea y las monedas
            // bajan hacia la izquierda. El resto de la pantalla no se toca.
            function recorrido() {
                return {
                    x: Math.max(1, lienzo.offsetWidth - mapa.clientWidth),
                    y: Math.max(1, lienzo.offsetHeight - mapa.clientHeight)
                };
            }

            // Punto de la pantalla donde se "apoya" el camino: el lugar del nivel 1
            // cuando recién se empieza (abajo a la izquierda).
            var ANCLA_X = 0.092;
            var ANCLA_Y = 0.813;
            var nodos = lienzo.querySelectorAll('.inicio-nodo');

            // Altura del camino (dentro de la capa) en una posición horizontal dada,
            // tomando como referencia el centro de las monedas.
            function alturaCamino(x) {
                if (!nodos.length) return 0;
                if (x <= nodos[0].offsetLeft) return nodos[0].offsetTop;
                for (var i = 1; i < nodos.length; i++) {
                    var a = nodos[i - 1], b = nodos[i];
                    if (x <= b.offsetLeft) {
                        var p = (x - a.offsetLeft) / (b.offsetLeft - a.offsetLeft);
                        return a.offsetTop + (b.offsetTop - a.offsetTop) * p;
                    }
                }
                return nodos[nodos.length - 1].offsetTop;
            }

            // La capa se corre hacia la izquierda y baja lo necesario para que el camino
            // siempre pase por el ancla: así en todo momento se ve como en la primera pantalla.
            function mover(valor) {
                var r = recorrido();
                avance = Math.max(0, Math.min(1, valor));
                var x = avance * r.x;
                var y = lienzo.offsetHeight - (1 - ANCLA_Y) * mapa.clientHeight
                        - alturaCamino(x + ANCLA_X * mapa.clientWidth);
                y = Math.max(0, Math.min(r.y, y));
                lienzo.style.transform = 'translate(' + (-x) + 'px, ' + y + 'px)';
            }

            // Rueda del mouse: hacia arriba avanza por el camino (que sube), hacia abajo vuelve.
            // Por eso deltaY va con el signo cambiado. El scroll horizontal queda igual.
            mapa.addEventListener('wheel', function (e) {
                e.preventDefault();
                var delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : -e.deltaY;
                if (e.deltaMode === 1) delta *= 40;
                mover(avance + delta / recorrido().x);
            }, { passive: false });

            // Arrastre con mouse o dedo.
            mapa.addEventListener('pointerdown', function (e) {
                if (e.button !== 0 || e.target.closest('.inicio-pantalla')) return;
                arrastre = { id: e.pointerId, x: e.clientX, y: e.clientY, inicio: avance, activo: false };
                huboArrastre = false;
            });

            mapa.addEventListener('pointermove', function (e) {
                if (!arrastre || e.pointerId !== arrastre.id) return;
                var dx = e.clientX - arrastre.x;
                var dy = e.clientY - arrastre.y;
                if (!arrastre.activo) {
                    if (Math.abs(dx) + Math.abs(dy) < 6) return;
                    arrastre.activo = true;
                    huboArrastre = true;
                    mapa.classList.add('inicio-arrastrando');
                    mapa.setPointerCapture(arrastre.id);
                }
                var r = recorrido();
                mover(arrastre.inicio + (dy - dx) / (r.x + r.y));
            });

            function soltar(e) {
                if (!arrastre || e.pointerId !== arrastre.id) return;
                arrastre = null;
                mapa.classList.remove('inicio-arrastrando');
            }
            mapa.addEventListener('pointerup', soltar);
            mapa.addEventListener('pointercancel', soltar);

            mapa.addEventListener('click', function (e) {
                if (huboArrastre) {
                    e.preventDefault();
                    e.stopPropagation();
                    huboArrastre = false;
                }
            }, true);

            mapa.addEventListener('dragstart', function (e) { e.preventDefault(); });
            window.addEventListener('resize', function () { mover(avance); });

            // Al entrar, el mapa arranca en el nivel que toca jugar: esa moneda queda
            // abajo a la izquierda, donde está el nivel 1 cuando recién se empieza.
            var actual = lienzo.querySelector('.inicio-nodo-actual');
            if (actual) {
                lienzo.style.transition = 'none';
                mover((actual.offsetLeft - mapa.clientWidth * ANCLA_X) / recorrido().x);
                lienzo.offsetWidth;
                lienzo.style.transition = '';
            }
        })();
    </script>
}
