@{
    ViewData["Title"] = "RIK - Educación Financiera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="rik">

    <header class="encabezado">
        <a class="marca" href="#inicio">
            <img src="@Url.Content("~/imagenes/rik-logo.png")" alt="Logo de RIK">
            <span>RIK</span>
        </a>

        <nav class="nav">
            <a href="#quienes-somos">Quienes somos</a>
            <a href="#nuestra-mision">Nuestra misión</a>
            <a href="#logros">Logros</a>
        </nav>

        <a class="boton-login" href="@Url.Action("Index", "Login")">
            Inicia Sesión
        </a>
    </header>

    <section class="portada" id="inicio">
        <div class="presentacion">
            <img class="mascota" src="@Url.Content("~/imagenes/rikLanding.png")" alt="Ricky, la mascota de RIK">

            <div class="tarjeta-presentacion" id="quienes-somos">
                <p>
                    Rik es una aplicación de educación financiera con el objetivo de enseñar a los jóvenes sobre finanzas de una forma que sea entretenida.
                </p>
            </div>

            <div class="logo-hero">
                <span>RiK</span>
                <small>Convertí el aprendizaje en riqueza</small>
            </div>

            <div class="tarjeta-mision" id="nuestra-mision">
                <p>
                    La misión que tenemos en Rik es que todos los jóvenes estén informados y concientizados sobre la economía, inversiones y el manejo del dinero para que puedan tener un futuro mejor.
                </p>
            </div>
        </div>
    </section>

    <section class="estadisticas" id="logros">
        <div class="estadistica">
            <div class="icono-estadistica">📈</div>
            <div>
                <h2>86%</h2>
                <p>de los jóvenes que aprenden<br />mejoran su plata y su futuro</p>
            </div>
        </div>

        <div class="estadistica">
            <div class="icono-estadistica">⚙️</div>
            <div>
                <h2>+12</h2>
                <p>Unidades didácticas interactivas<br />basadas en situaciones reales</p>
            </div>
        </div>

        <div class="estadistica">
            <div class="icono-estadistica">🏆</div>
            <div>
                <h2>100%</h2>
                <p>Contenido libre de sesgos y<br />certificado por expertos en finanzas</p>
            </div>
        </div>
    </section>

    <section class="funcionalidades" id="funcionalidades">
        <div class="titulo-seccion">
            <p class="subtitulo">GAMIFICACIÓN CON PROPÓSITO</p>
            <h2>Todo lo que necesitás para ganar el juego del dinero</h2>
            <p>
                Sin tecnicismos aburridos ni clases interminables. Aprendé con micro-desafíos prácticos.
            </p>
        </div>

        <div class="contenedor-tarjetas">
            <div class="tarjeta-funcion">
                <div class="icono-funcion icono-verde">🎮</div>
                <h3>Aprende Jugando</h3>
                <p>Micro-lecciones de 5 min con retos, videos e imágenes para construir un hábito diario.</p>
                <a href="#">Explorar lecciones</a>
            </div>

            <div class="tarjeta-funcion">
                <div class="icono-funcion icono-amarillo">💰</div>
                <h3>Simulador Integrado</h3>
                <p>Practica cómo ahorrar, invertir y tomar decisiones con escenarios reales y dinámicos.</p>
                <a href="#">Probar simulador</a>
            </div>

            <div class="tarjeta-funcion">
                <div class="icono-funcion icono-lila">📊</div>
                <h3>Comunidad y Logros</h3>
                <p>Competí con tus amigos, obtiene medallas y comparte tus avances dentro de la comunidad.</p>
                <a href="#">Ver clasificaciones</a>
            </div>

            <div class="tarjeta-funcion">
                <div class="icono-funcion icono-verde">🤖</div>
                <h3>Coach con IA</h3>
                <p>Consulta dudas sobre ahorro, presupuesto e inversiones en cualquier momento del día.</p>
                <a href="#">Hablar con Ricky</a>
            </div>
        </div>
    </section>

    <section class="cierre">
        <div class="caja-cierre">
            <div class="icono-cierre">99</div>

            <div class="texto-cierre">
                <h2>"El conocimiento financiero no debe ser un privilegio, sino una oportunidad para todos."</h2>
                <p>Manifesto RIK</p>
            </div>

            <a class="boton-cierre" href="@Url.Action("Index", "Login")">
                Únete a más de 25.000 estudiantes ahora
            </a>
        </div>
    </section>

</main>
