@{
    ViewData["Title"] = "RIK - Educación Financiera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="rik">


    <section class="portada" id="inicio">
        <div class="presentacion">
            <img class="mascota" src="@Url.Content("~/imagenes/rikLanding.png")" alt="Ricky, la mascota de RIK">

            <div class="tarjeta-presentacion" id="quienes-somos">
                <p>
                    Rik es una aplicación de educación financiera con el objetivo de enseñar a los jóvenes sobre finanzas de una forma que sea entretenida.
                </p>
            </div>

            <div class="logo-hero">
                <img src="@Url.Content("~/imagenes/slogan.png")" alt="Logo de RIK">
            </div>

            <div class="tarjeta-mision" id="nuestra-mision">
                <p>
                    La misión que tenemos en Rik es que todos los jóvenes estén informados y concientizados sobre la economía, inversiones y el manejo del dinero para que puedan tener un futuro mejor.
                </p>
            </div>
        </div>
    </section>

    <section class="estadisticas" id="logros">
        <div class="estadistica">
            <div class="icono-estadistica">📈</div>
            <div>
                <h2>86%</h2>
                <p>de los jóvenes que aprenden<br />mejoran su plata y su futuro</p>
            </div>
        </div>

        <div class="estadistica">
            <div class="icono-estadistica">⚙️</div>
            <div>
                <h2>+12</h2>
                <p>Unidades didácticas interactivas<br />basadas en situaciones reales</p>
            </div>
        </div>

        <div class="estadistica">
            <div class="icono-estadistica">🏆</div>
            <div>
                <h2>100%</h2>
                <p>Contenido libre de sesgos y<br />certificado por expertos en finanzas</p>
            </div>
        </div>
    </section>

    <!-- CARRUSEL -->
    <section class="galeria" id="galeria">
        <div id="carouselStackedBottom" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner rounded-5">
                <div class="carousel-item active">
                    <img src="@Url.Content("~/imagenes/carrusel1.png")" class="d-block w-100" alt="Pantalla de la app RIK 1">
                </div>
                <div class="carousel-item">
                    <img src="@Url.Content("~/imagenes/carrusel2.png")" class="d-block w-100" alt="Pantalla de la app RIK 2">
                </div>
                <div class="carousel-item">
                    <img src="@Url.Content("~/imagenes/carrusel3.png")" class="d-block w-100" alt="Pantalla de la app RIK 3">
                </div>
            </div>

            <div>
                <button class="btn-icon btn-sm" type="button" data-bs-target="#carouselStackedBottom" data-bs-slide="prev">
                    <span class="carousel-icon-prev" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="btn-icon btn-sm" type="button" data-bs-target="#carouselStackedBottom" data-bs-slide="next">
                    <span class="carousel-icon-next" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        </div>
    </section>

    <section class="cierre">
        <div class="caja-cierre">

            <div class="texto-cierre">
                <h2>"El conocimiento financiero no debe ser un privilegio, sino una oportunidad para todos."</h2>
                <p>Manifesto RIK</p>
            </div>

            <a class="boton-cierre" href="@Url.Action("Index", "Login")">
                Únete a más de 25.000 estudiantes ahora
            </a>
        </div>
    </section>

</main>