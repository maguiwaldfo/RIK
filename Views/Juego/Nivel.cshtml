
@using RIK.Models

@{
    List<Pregunta> preguntas = ViewBag.PreguntasNivel;
    Nivel nivel = ViewBag.NumeroNivel;
    int numero = 0;
}

<h1>@nivel.Tema</h1>

<h3 id="vidas">Vidas: ❤️❤️❤️</h3>
<h3 id="puntos">Puntos: 0</h3>
<h3 id="tiempo">Tiempo: 00:00</h3>

<p id="contador">Pregunta 1 de 8</p>

@foreach (Pregunta pregunta in preguntas)
{
    <div id="pregunta-@numero" style="display:none">

        <h2>@pregunta.Enunciado</h2>

        @foreach (Opcion opcion in pregunta.Opciones)
        {
            <button type="button" onclick="comprobar(@pregunta.Id, @opcion.Id)">
                @opcion.Texto
            </button>
        }

    </div>

    numero++;
}

<p id="resultado"></p>

<button type="button" id="siguiente"
        onclick="siguientePregunta()" style="display:none">
    Siguiente
</button>

<button type="button" id="finalizar"
        onclick="finalizarNivel()" style="display:none">
    Finalizar nivel
</button>

<script src="~/js/nivel.js"></script>
