@using RIK.Models

@{
    ViewData["Title"] = ViewBag.TemaNivel;
    int numero = 0;
}

<div class="charla nivel">

    <!-- PROGRESO, VIDAS Y TIEMPO -->
    <div class="charla-estado">
        <div class="charla-barra">
            <div class="charla-barra-relleno" id="barraProgreso" style="width: 0%;"></div>
        </div>
        <span class="charla-porcentaje" id="porcentaje">0%</span>
        <span class="charla-vidas">
            <span id="vidas">3</span>
            <span class="charla-corazon" aria-label="vidas">&#10084;</span>
        </span>
        <span class="nivel-tiempo" id="tiempo" aria-label="Tiempo">00:00</span>
    </div>

    <!-- PREGUNTAS: se muestra una por vez -->
    @foreach (Pregunta pregunta in ViewBag.PreguntasNivel)
    {
        <div class="nivel-pregunta" id="pregunta-@numero" style="display: none;">

            <h2 class="nivel-enunciado">@pregunta.Enunciado</h2>

            <div class="nivel-opciones">
                @foreach (Opcion opcion in pregunta.Opciones)
                {
                    <button type="button" class="nivel-opcion"
                            onclick="elegirOpcion(this, @pregunta.Id, @opcion.Id)">
                        @opcion.Texto
                    </button>
                }
            </div>

        </div>

        numero++;
    }

    <p class="nivel-resultado" id="resultado"></p>

    <div class="charla-acciones">
        <button type="button" class="charla-boton" id="enviar" onclick="enviarRespuesta()" disabled>
            Enviar
        </button>

        <button type="button" class="charla-boton" id="siguiente" onclick="siguientePregunta()" style="display: none;">
            Siguiente
        </button>

        <button type="button" class="charla-boton" id="finalizar" onclick="finalizarNivel()" style="display: none;">
            Terminar lección
        </button>
    </div>
</div>

<script src="~/js/nivel.js" asp-append-version="true"></script>
