
@using RIK.Models

@{
    List<Pregunta> preguntas = ViewBag.PreguntasNivel;
    int numero = 0;
}

@foreach (Pregunta pregunta in preguntas)
{
    <div id="pregunta-@numero" class="nivel-pregunta" style="display:none">

        <h2>@pregunta.Enunciado</h2>

        <button onclick="comprobar(@pregunta.Id, 1)">
            @pregunta.Opcion1
        </button>

        <button onclick="comprobar(@pregunta.Id, 2)">
            @pregunta.Opcion2
        </button>

        <button onclick="comprobar(@pregunta.Id, 3)">
            @pregunta.Opcion3
        </button>

        <button onclick="comprobar(@pregunta.Id, 4)">
            @pregunta.Opcion4
        </button>

    </div>

    numero++;
}

<p id="resultado"></p>

<button id="siguiente" onclick="siguientePregunta()" style="display:none">
    Siguiente
</button>

<button id="finalizar" onclick="finalizarNivel()" style="display:none">
    Finalizar nivel
</button>

<script>
    let cantidadPreguntas = @preguntas.Count;
</script>

<script src="~/js/nivel.js"></script>
