@using RIK.Models

@{
    int numero = 0;
}

<h1>@ViewBag.TemaNivel</h1>

<h3 id="vidas">Vidas: ❤️❤️❤️</h3>
<h3 id="puntos">Puntos: 0</h3>
<h3 id="tiempo">Tiempo: 00:00</h3>

<p id="contador">Pregunta 1 de 8</p>

@foreach (Pregunta pregunta in ViewBag.PreguntasNivel)
{
    <div id="pregunta-@numero" style="display:none">

        <h2>@pregunta.Enunciado</h2>

        @foreach (Opcion opcion in pregunta.Opciones)
        {
            <button type="button" onclick="comprobar(@pregunta.Id, @opcion.Id)">
                @opcion.Texto
            </button>
        }

    </div>

    numero++;
}

<p id="resultado"></p>

<button type="button" id="siguiente" onclick="siguientePregunta()" style="display: none; width: 978px; height: 88px; background: #FFD700; border-radius: 20px; border: none; color: black; font-size: 48px; font-family: 'Poppins', sans-serif; font-weight: 400; cursor: pointer;">
    Siguiente
</button>

<button type="button" id="finalizar" onclick="finalizarNivel()" style="display: none; width: 978px; height: 88px; background: #FFD700; border-radius: 20px; border: none; color: black; font-size: 48px; font-family: 'Poppins', sans-serif; font-weight: 400; cursor: pointer;">
    Terminar lección
</button>


<script src="~/js/nivel.js"></script>
