
@using RIK.Models

@{
    List<Pregunta> preguntas = ViewBag.PreguntasNivel;
}

@foreach (Pregunta pregunta in preguntas)
{
    <div class="nivel-pregunta">

        <h2>@pregunta.Enunciado</h2>

        <button onclick="comprobar(@pregunta.Id, 1)">
            @pregunta.Opcion1
        </button>

        <button onclick="comprobar(@pregunta.Id, 2)">
            @pregunta.Opcion2
        </button>

        <button onclick="comprobar(@pregunta.Id, 3)">
            @pregunta.Opcion3
        </button>

        <button onclick="comprobar(@pregunta.Id, 4)">
            @pregunta.Opcion4
        </button>

    </div>
}

<p id="resultado"></p>

<script src="~/js/nivel.js"></script>
