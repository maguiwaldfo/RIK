@{
    ViewData["Title"] = "Resultado";
}

@* Todos los datos (gano, xp, tiempo, aciertos, idNivel) los calcula JuegoController.Resultado *@
<div class="fin @(ViewBag.Gano ? "fin-gano" : "fin-perdio")">

    <p class="fin-mensaje">
        @if (ViewBag.Gano)
        {
            <text>¡Pudiste aprender un tema nuevo! ¡Felicidades!</text>
        }
        else
        {
            <text>¡Te quedaste sin vidas! Perdiste el nivel</text>
        }
    </p>

    <div class="fin-cuerpo">

        <img class="fin-mascota"
             src="@ViewBag.ImagenMascota"
             alt="@(ViewBag.Gano ? "Riky festejando" : "Riky triste")" />

        <div class="fin-datos">
            <div class="fin-dato fin-dato-xp">
                <span class="fin-etiqueta">XP</span>
                <span class="fin-valor">+@ViewBag.Xp pts</span>
            </div>

            <div class="fin-dato">
                <span class="fin-etiqueta">Tiempo</span>
                <span class="fin-valor">@ViewBag.Tiempo min</span>
            </div>

            <div class="fin-dato">
                <span class="fin-etiqueta">Aciertos</span>
                <span class="fin-valor">@(ViewBag.Aciertos)%</span>
            </div>
        </div>

    </div>

    <!-- Botones abajo de todo. Si ganó: solo "Volver". Si perdió: "Volver" y "Repasar tema", mitad y mitad. -->
    <div class="fin-acciones">
        <a class="charla-boton fin-boton" href="@Url.Action("IndexInicio", "Inicio")">Volver</a>

        @if (!ViewBag.Gano && ViewBag.IdNivel != 0)
        {
            <a class="charla-boton fin-boton" href="@Url.Action("Teoria", "Juego", new { idNivel = ViewBag.IdNivel })">Repasar tema nuevamente</a>
        }
    </div>
</div>
