@{
    ViewData["ClaseBody"] = "pagina-juego";
}

<div class="@ViewBag.ClaseFin">
    <p class="fin-mensaje">@ViewBag.MensajeFin</p>

    <div class="fin-cuerpo">
        <img class="fin-mascota"
             src="@ViewBag.ImagenMascota"
             alt="@ViewBag.AltMascota" />

<!-- elemento sacado del figma (con cambios para adaptarlo mejor con los datos) -->
        <div class="fin-estadistica">
            <div class="fin-caja"></div>
            <span class="fin-valor">@ViewBag.Xp</span>
            <span class="fin-etiqueta">XP</span>
        </div>

        <div class="fin-estadistica">
            <div class="fin-caja"></div>
            <span class="fin-valor">@ViewBag.Tiempo</span>
            <span class="fin-etiqueta">Tiempo</span>
        </div>

        <div class="fin-estadistica">
            <div class="fin-caja"></div>
            <span class="fin-valor">@ViewBag.TextoAciertos</span>
            <span class="fin-etiqueta">Aciertos</span>
        </div>

        <!-- Botones abajo de todo. Si ganó: solo "Volver". Si perdió: "Volver" y "Repasar tema". -->
        <div class="fin-acciones @(ViewBag.OcultarRepasar ? "fin-acciones-una" : "")">
            <a class="juego-boton fin-boton" href="@Url.Action("IndexInicio", "Inicio")">Volver</a>
            <a class="juego-boton fin-boton" href="@ViewBag.UrlRepasar" hidden="@ViewBag.OcultarRepasar">Repasar tema nuevamente</a>
        </div>
    </div>
</div>
