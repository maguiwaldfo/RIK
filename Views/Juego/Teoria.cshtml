@{
    int numeroMensaje = 0;
    var nivel = ViewBag.Nivel as Nivel;
    var charla = ViewBag.Charla as List<CharlaTeoria> ?? new List<CharlaTeoria>();

}

@foreach (CharlaTeoria mensaje in charla)
{
    <div id="mensaje-@numeroMensaje" class="mensaje" style="display:none">
        <p><strong>@mensaje.Personaje:</strong> @mensaje.Texto</p>
    </div>

    numeroMensaje++;
}

<button id="siguienteMensaje" onclick="mostrarMensaje()">
    Siguiente
</button>

<a id="comenzar" style="display:none"
   href="@Url.Action("Nivel", "Juego", new { nivelElegido = nivel.Id })">
    Comenzar desafío
</a>