@using RIK.Models

@* El título, el nivel, la charla y las imágenes de los personajes los carga JuegoController.Teoria *@

@if (ViewBag.Nivel == null)
{
    <p>No se encontró el nivel solicitado.</p>
    <a href="@Url.Action("Index", "Biblioteca")">Volver</a>
}
else
{
    <div class="charla charla-teoria" id="charla" data-cuerpo-chico="@ViewBag.CuerpoChico" data-cuerpo-perro="@ViewBag.CuerpoPerro">

        <h1 class="charla-tema">@ViewBag.TemaNivel</h1>

        <!-- PASO A PASO: lo arma el script, de a dos mensajes, con los personajes de medio cuerpo -->
        <div class="charla-paso" id="charlaPaso" hidden></div>

        <!-- RESUMEN: la charla completa con las caras. Se muestra al terminar el paso a paso -->
        <div class="charla-resumen" id="charlaResumen">
            @foreach (CharlaTeoria mensaje in ViewBag.Charla)
            {
                bool esChico = string.Equals(mensaje.Personaje?.Trim(), "Chico", StringComparison.OrdinalIgnoreCase);

                <div class="charla-fila @(esChico ? "charla-fila-chico" : "charla-fila-perro")"
                     data-personaje="@(esChico ? "chico" : "perro")">
                    <img class="charla-cara"
                         src="@(esChico ? ViewBag.CaraChico : ViewBag.CaraPerro)"
                         alt="@mensaje.Personaje" />
                    <p class="charla-globo">@mensaje.Texto</p>
                </div>
            }
        </div>

        <div class="charla-acciones">
            <button type="button" class="charla-boton" id="charlaSiguiente" hidden>Siguiente</button>
            <a class="charla-boton" id="charlaComenzar"
               href="@Url.Action("Nivel", "Juego", new { nivelElegido = ViewBag.IdNivel })">
                Comenzar desafío
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var charla = document.getElementById('charla');
            if (!charla) return;

            var paso = document.getElementById('charlaPaso');
            var resumen = document.getElementById('charlaResumen');
            var siguiente = document.getElementById('charlaSiguiente');
            var comenzar = document.getElementById('charlaComenzar');

            // Los mensajes salen del resumen que ya vino armado desde el servidor.
            var mensajes = [].map.call(resumen.querySelectorAll('.charla-fila'), function (fila) {
                return {
                    personaje: fila.getAttribute('data-personaje'),
                    texto: fila.querySelector('.charla-globo').textContent
                };
            });
            if (mensajes.length === 0) return;

            // Se muestran de a dos (pregunta y respuesta). Si al final queda uno suelto,
            // se suma al último paso.
            var pasos = [];
            for (var i = 0; i < mensajes.length; i += 2) {
                pasos.push(mensajes.slice(i, i + 2));
            }
            if (pasos.length > 1 && pasos[pasos.length - 1].length === 1) {
                var suelto = pasos.pop();
                pasos[pasos.length - 1] = pasos[pasos.length - 1].concat(suelto);
            }

            var imagenes = {
                chico: charla.getAttribute('data-cuerpo-chico'),
                perro: charla.getAttribute('data-cuerpo-perro')
            };
            var actual = 0;

            function mostrarPaso() {
                paso.innerHTML = '';
                pasos[actual].forEach(function (mensaje) {
                    var fila = document.createElement('div');
                    fila.className = 'charla-fila charla-fila-' + mensaje.personaje;

                    var imagen = document.createElement('img');
                    imagen.className = 'charla-cuerpo';
                    imagen.src = imagenes[mensaje.personaje];
                    imagen.alt = mensaje.personaje === 'chico' ? 'Chico' : 'Riky';

                    var globo = document.createElement('p');
                    globo.className = 'charla-globo';
                    globo.textContent = mensaje.texto;

                    fila.appendChild(imagen);
                    fila.appendChild(globo);
                    paso.appendChild(fila);
                });
            }

            function mostrarResumen() {
                paso.hidden = true;
                siguiente.hidden = true;
                resumen.hidden = false;
                comenzar.hidden = false;
            }

            siguiente.addEventListener('click', function () {
                actual++;
                if (actual < pasos.length) {
                    mostrarPaso();
                } else {
                    mostrarResumen();
                }
            });

            // Arranque: se esconde el resumen y se muestra el primer paso.
            resumen.hidden = true;
            comenzar.hidden = true;
            paso.hidden = false;
            siguiente.hidden = false;
            mostrarPaso();
        })();
    </script>
}
