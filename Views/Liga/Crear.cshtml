@{
    ViewData["ClaseBody"] = "fondo-degradado";
    ViewData["ClaseMain"] = "pagina-crearliga";
}

<h1 class="crearliga-titulo">Crear una nueva Liga</h1>

<form class="card crearliga-form" action="@Url.Action("Crear", "Liga")" method="post">
    <div class="crearliga-campo">
        <label class="form-label campo-titulo">Nombre de la Liga:</label>
        <input type="text" class="form-control" name="Nombre" required />
    </div>

    <div class="crearliga-campo">
        <label class="form-label campo-titulo">Capacidad Máxima:</label>
        <input type="number" class="form-control" name="Capacidad" value="10" required />
    </div>

    <div class="crearliga-campo">
        <p class="campo-titulo form-label">Privacidad</p>
        <select class="form-select" name="Privacidad" id="Privacidad" onchange="ActualizarContraseña()">
            <option value="false">Pública</option>
            <option value="true">Privada con Contraseña</option>
        </select>
    </div>

    <div class="crearliga-campo crearliga-contrasena" id="contrsena">
        <label class="form-label campo-titulo">Contraseña:</label>
        <input type="password" class="form-control" name="Contraseña" id="Contraseña" />
    </div>

    <p class="alert alert-danger crearliga-error" hidden="@ViewBag.OcultarError">@ViewBag.Error</p>

    <button type="submit" class="boton-3d guardarliga-boton">Guardar Liga</button>
</form>

<a class="link-volver crearliga-volver" href="@Url.Action("Index", "Liga")">Volver a Ligas</a>

<script src="~/js/Liga.js"></script>