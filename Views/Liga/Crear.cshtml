@* El título y el mensaje de error los prepara LigaController.Crear *@

<h1>Crear una nueva Liga</h1>

<form action="@Url.Action("Crear", "Liga")" method="post">
    <div>
        <label>Nombre de la Liga:</label>
        <input type="text" name="Nombre" required />
    </div>

    <br />

    <div>
        <label>Capacidad Máxima:</label>
        <input type="number" name="Capacidad" value="10" required />
    </div>

    <br />

    <select name="Privacidad" id="Privacidad" onchange="ActualizarContraseña()">
        <option value="false">Pública</option>
        <option value="true">Privada con Contraseña</option>
    </select>

    <br/>
    <br/>

    <div id="contrsena">
        <label>Contraseña:</label>
        <input type="password" name="Contraseña" id="Contraseña" />
    </div>

    <p hidden="@ViewBag.OcultarError">@ViewBag.Error</p>

    <br />

    <button type="submit">Guardar Liga</button>
</form>

<br />

<a href="@Url.Action("Index", "Liga")">Volver a Ligas</a>


<script src="~/js/Liga.js"></script>