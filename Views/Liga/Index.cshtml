@* Todos los datos y las decisiones (qué se muestra y qué no) los prepara LigaController.Index.
   hidden="@ViewBag.Ocultar..." deja el elemento oculto cuando el controlador manda true. *@

<h1>Tabla de Posiciones</h1>

<div>
    <a href="@Url.Action("Crear", "Liga")">Crear Nueva Liga</a>
</div>

<section class="liga-aviso" role="status" hidden="@ViewBag.OcultarAviso">@ViewBag.Mensaje</section>

<hr />

<h2>Mis Ligas</h2>

<div class="lista-ligas">
    @foreach (Liga liga in ViewBag.Ligas)
    {
        <div class="liga">
            <h3>@liga.Nombre</h3>
            <a href="@Url.Action("Index", "Liga", new { idLigaAmigos = liga.Id })">
                Ver liga
            </a>
        </div>
    }

    <a class="liga-unirse" href="@Url.Action("UnirseALiga", "Liga")">+ Unirse a una liga</a>
</div>

<hr />

<h2>Ranking Global</h2>

<div class="ranking-global">
    <div class="ranking-tabla" hidden="@ViewBag.OcultarRankingGlobal">
        @foreach (FilaRanking fila in ViewBag.RankingGlobal)
        {
            <div class="@fila.Clase">
                <div class="ranking-izquierda">
                    <div class="ranking-posicion">
                        <div class="ranking-posicion-texto">@fila.Posicion</div>
                    </div>
                    <div class="ranking-avatar">
                        <div class="ranking-avatar-cuadrado"></div>
                    </div>
                    <div class="ranking-nombre-columna">
                        <div class="ranking-nombre">@fila.Nombre</div>
                        <div class="ranking-subtitulo">@fila.Subtitulo</div>
                    </div>
                </div>
                <div class="ranking-derecha">
                    <div class="ranking-puntos">
                        <div class="ranking-puntos-texto">@fila.Puntos</div>
                    </div>
                </div>
            </div>
        }
    </div>
    <p hidden="@ViewBag.OcultarMensajeRankingGlobal">@ViewBag.MensajeRankingGlobal</p>
</div>

<hr />

<h2>@ViewBag.TituloLiga</h2>

<div class="ranking-liga">
    <div class="ranking-tabla" hidden="@ViewBag.OcultarRankingLiga">
        @foreach (FilaRanking fila in ViewBag.RankingLiga)
        {
            <div class="@fila.Clase">
                <div class="ranking-izquierda">
                    <div class="ranking-posicion">
                        <div class="ranking-posicion-texto">@fila.Posicion</div>
                    </div>
                    <div class="ranking-avatar">
                        <div class="ranking-avatar-cuadrado"></div>
                    </div>
                    <div class="ranking-nombre-columna">
                        <div class="ranking-nombre">@fila.Nombre</div>
                        <div class="ranking-subtitulo">@fila.Subtitulo</div>
                    </div>
                </div>
                <div class="ranking-derecha">
                    <div class="ranking-puntos">
                        <div class="ranking-puntos-texto">@fila.Puntos</div>
                    </div>
                </div>
            </div>
        }
    </div>
    <p hidden="@ViewBag.OcultarMensajeRankingLiga">@ViewBag.MensajeRankingLiga</p>
</div>

<section class="liga-compartir" hidden="@ViewBag.OcultarCompartir">
    <h3>Invitá a tus amigos</h3>
    <p>Compartí este link para que se sumen a la liga.</p>

    <div class="liga-compartir-link">
        <label class="visually-hidden" for="linkInvitacion">Link de invitación</label>
        <input id="linkInvitacion" type="text" value="@ViewBag.LinkInvitacion" readonly />
        <button type="button" onclick="CopiarLinkInvitacion()">Copiar link</button>
    </div>
    <span id="linkCopiado" class="liga-compartir-estado" aria-live="polite"></span>

    <a class="liga-solicitudes" href="@ViewBag.UrlSolicitudes" hidden="@ViewBag.OcultarSolicitudes">
        Ver solicitudes
        <span class="liga-solicitudes-cantidad" hidden="@ViewBag.OcultarCantidadSolicitudes">@ViewBag.CantidadSolicitudes</span>
    </a>
</section>

<form action="@ViewBag.UrlAccionLiga" method="post" hidden="@ViewBag.OcultarAccionLiga">
    <input type="hidden" name="idLiga" value="@ViewBag.IdLiga" />
    <button type="submit">@ViewBag.TextoBotonLiga</button>
</form>

<script src="~/js/Liga.js"></script>
