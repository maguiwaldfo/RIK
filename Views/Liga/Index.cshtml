@{
    ViewData["Title"] = "Ligas y Tabla de Posiciones";
}

<h1>Tabla de Posiciones</h1>

<div>
    <a href="@Url.Action("Crear", "Liga")">Crear Nueva Liga</a>
</div>

<hr />

<h2>Ranking Global</h2>
@Html.Raw(ViewBag.HtmlTablaGlobal)

<hr />

<h2>@ViewBag.TituloLiga</h2>
@Html.Raw(ViewBag.HtmlTablaLiga)

@if (ViewBag.IdLiga != null && ViewBag.IdLiga > 0)
{
    <form action="/Liga/@ViewBag.AccionLiga" method="post">
        <input type="hidden" name="idLiga" value="@ViewBag.IdLiga" />
        <button type="submit">@ViewBag.TextoBotonLiga</button>
    </form>
}