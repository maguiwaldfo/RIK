@model LigaBusqueda

@*
    Tarjeta de una liga en "Unirse a una liga".
    ViewData["Codigo"]: código del link de invitación (vacío si se llegó buscando).
    ViewData["Busqueda"]: texto buscado, para volver a la misma búsqueda después de enviar.
*@
@{
    string codigo = ViewData["Codigo"] as string ?? "";
    string busqueda = ViewData["Busqueda"] as string ?? "";
    string idContraseña = "contraseña-" + Model.Id;
}

<article class="unirse-tarjeta">
    <div class="unirse-tarjeta-info">
        <h3>@Model.Nombre</h3>
        <p>
            Creada por @Model.NombreCreador · @Model.CantidadMiembros/@Model.Capacidad miembros
        </p>
    </div>

    @if (Model.Privacidad)
    {
        <span class="unirse-etiqueta unirse-etiqueta-privada">Privada</span>
    }
    else
    {
        <span class="unirse-etiqueta">Pública</span>
    }

    <div class="unirse-tarjeta-accion">
        @if (Model.EsMiembro)
        {
            <a class="unirse-boton unirse-boton-secundario" href="@Url.Action("Index", "Liga", new { idLigaAmigos = Model.Id })">Ya sos parte · Ver liga</a>
        }
        else if (Model.SolicitudPendiente)
        {
            <span class="unirse-estado">Solicitud enviada, esperando respuesta</span>
        }
        else if (Model.EstaLlena)
        {
            <span class="unirse-estado">Liga completa</span>
        }
        else
        {
            <form class="unirse-form-accion" asp-controller="Liga" asp-action="SolicitarUnirse" method="post">
                <input type="hidden" name="idLiga" value="@Model.Id" />
                <input type="hidden" name="busqueda" value="@busqueda" />

                @if (!Model.Privacidad)
                {
                    <button class="unirse-boton" type="submit">Unirse</button>
                }
                else if (codigo != "")
                {
                    @* Con el link de invitación no hace falta la contraseña, pero el dueño igual tiene que aceptar *@
                    <input type="hidden" name="codigo" value="@codigo" />
                    <button class="unirse-boton" type="submit">Solicitar unirse</button>
                }
                else
                {
                    <label class="visually-hidden" for="@idContraseña">Contraseña de la liga</label>
                    <input id="@idContraseña" type="password" name="contraseña" placeholder="Contraseña" maxlength="50" autocomplete="off" required />
                    <button class="unirse-boton" type="submit">Solicitar unirse</button>
                }
            </form>
        }
    </div>
</article>
