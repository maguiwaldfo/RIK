@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Iniciar sesión</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <header class="login-header">
        <div class="login-brand">
            <div class="brand-mark">R</div>
            <span>RIK</span>
        </div>

        <nav class="login-nav" aria-label="Navegación principal">
            <a href="#">Quienes somos</a>
            <a href="#">Nuestra misión</a>
            <a href="#">Logros</a>
        </nav>

        <a class="login-button" href="#">Inicio Sesión</a>
    </header>

    <main class="login-main">
        <section class="login-panel">
            <form class="login-form" method="post" action="@Url.Action("IniciarSesion", "Login")" onsubmit="return validarLogin()">
                <div class="form-field">
                    <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Correo" />
                </div>

                <div class="form-field">
                    <input type="password" id="contrasena" name="contrasena" placeholder="Contraseña" />
                </div>

                <button type="submit" class="submit-button">Iniciar sesión</button>

                <div class="social-login">
                    <span>O continuar con:</span>
                    <div class="social-buttons">
                        <button type="button" class="social-button google">G</button>
                        <button type="button" class="social-button apple"></button>
                    </div>
                </div>
            </form>
            <p id="fb-login" class="feedback"></p>
        </section>

        <div class="mascot" aria-hidden="true">
            <div class="ear left"></div>
            <div class="ear right"></div>
            <div class="face">
                <div class="eye left"></div>
                <div class="eye right"></div>
                <div class="snout"></div>
                <div class="smile"></div>
            </div>
        </div>
    </main>
</body>
</html>