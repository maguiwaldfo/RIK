@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Iniciar sesión</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <header class="login-header">
        <div class="login-brand">
            <div class="brand-mark">R</div>
            <span>RIK</span>
        </div>

        <nav class="login-nav" aria-label="Navegación principal">
            <a href="#">Quienes somos</a>
            <a href="#">Nuestra misión</a>
            <a href="#">Logros</a>
        </nav>

        <a class="login-button" href="#">Inicio Sesión</a>
    </header>

    <main class="login-main">
        <section class="login-panel">
            <form class="login-form" method="post" action="@Url.Action("IniciarSesion", "Login")" onsubmit="return validarLogin()">
                <div class="form-field">
                    <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="nombre de usuario" />
                </div>

                <div class="form-field">
                    <input type="password" id="contrasena" name="contrasena" placeholder="Contraseña" />
                </div>

                <button type="submit" class="submit-button">Iniciar sesión</button>

                <div class="social-login">
                    <div class="register-link">
                        <span>¿No tienes una cuenta?</span>
                        <a href="@Url.Action("Registrarse", "Login")">Regístrate</a>
                    </div>
            </form>
        </section>
    </main>
    <script src="login.js"></script>
</body>
</html>