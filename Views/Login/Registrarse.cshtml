@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Registrarse</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="registro-body">
<header class="login-header">
        <div class="login-brand">
            <a href="@Url.Action("Landing", "Inicio")" class="brand-link">
                <img src="~/imagenes/rik-logo.png" alt="Logo RIK" class="brand-logo" />
            </a>
            <span>RIK</span>
        </div>
        <a class="login-button" href="@Url.Action("Landing", "Inicio")">Volver</a>
    </header>

    <main class="login-main">
        <div class="registro-imagotipo-wrap">
            <img src="~/imagenes/IMAGOTIPO.png" alt="Logo RIK" class="registro-imagotipo" />
        </div>

        <section class="registro-panel">

            <form id="registroForm"
                  class="login-form"
                  action="@Url.Action("ValidarUsuario", "Login")"
                  method="post"
                  onsubmit="return registrarUsuario()">

                <div class="form-field">
                    <input type="text" id="nombre" name="nombre" placeholder="Nombre" />
                    <p id="fb-nombre" class="feedback"></p>
                </div>

                <div class="form-field">
                    <input type="email" id="email" name="email" placeholder="email" />
                    <p id="fb-apellido" class="feedback"></p>
                </div>

                <div class="form-field">
                    <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Nombre de usuario" />
                    <p id="fb-nombreUsuario" class="feedback"></p>
                    <p class="feedback">@ViewBag.ErrorMessage</p>
                </div>

                <div class="form-field">
                    <input type="password" id="contrasena" name="contraseña" placeholder="Contraseña" />
                </div>
                <p id="fb-contrasena" class="feedback"></p>
                <button type="submit" class="submit-button">Registrarse</button>

                <div class="social-login">
                    <div class="register-link">
                        <span>¿Ya tenés una cuenta?</span>
                        <a href="@Url.Action("Index", "Login")">Iniciá sesión</a>
                    </div>
                </div>
            </form>

            <div id="resultado"></div>
        </section>
    </main>
    <script src="~/js/registrarse.js"></script>
</body>
</html>
