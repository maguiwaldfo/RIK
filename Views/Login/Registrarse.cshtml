@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Registrarse</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="registro-body">
<header class="registrarse-header">
        <div class="registrarse-brand">
            <div class="brand-mark">R</div>
            <span>RIK</span>
        </div>

        <nav class="registrarse-nav" aria-label="Navegación principal">
            <a href="#">Quienes somos</a>
            <a href="#">Nuestra misión</a>
            <a href="#">Logros</a>
        </nav>

    </header>
    <h2>Registrarse</h2>
    <form id="registroForm" class="registro-panel" action='@Url.Action("ValidarUsuario", "Login")' method="post" onsubmit="return registrarUsuario()">
        <div>
            <label for="nombre">Nombre:</label>
            <input type="text" id="nombre" name="nombre" placeholder="Pedro">
            <p id="fb-nombre" class="feedback"></p>
        </div>

        <div>
            <label for="nombreUsuario">Nombre de Usuario:</label>
            <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Ej: tuUsuario123">
            <p id="fb-nombreUsuario" class="feedback"></p>
        </div>

        <div>
            <label for="contrasena">Contraseña:</label>
            <input type="password" id="contrasena" name="contrasena" placeholder="Ingrese una contraseña">
            <p id="fb-contrasena" class="feedback"></p>
        </div>

        <div>
            <label for="apellido">Apellido:</label>
            <input type="text" id="apellido" name="apellido" placeholder="Martinez">
            <p id="fb-apellido" class="feedback"></p>
        </div>

        <br>
        <input type="submit" value="Registrarse">
    </form>
        
        <p>¿Ya tienes una cuenta? <a href="@Url.Action("Index", "Login")">Inicia sesión</a></p>
        <p>@ViewBag.ErrorMessage</p>

    <div id="resultado"></div>

    <script src="registrarse.js"></script>
</body>
</html>