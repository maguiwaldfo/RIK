@{
    ViewData["ClaseBody"] = "pagina-perfil";
}

<body class="mapa-body">
<main class="perfil">
    <h1 class="perfil-titulo">Ajustes</h1>

    <section class="list-group caja-blanca">

        <div class="list-group-item item-simple perfil-opcion">
            <a class="list-group-item-action opcion-boton opcion-proximamente icono-accesibilidad"><strong>Accesibilidad</strong><span class="badge proximamente">Próximamente</span></a>
        </div>

        <div class="list-group-item item-simple perfil-opcion">
            <a class="list-group-item-action opcion-boton opcion-proximamente icono-soporte"><strong>Soporte</strong><span class="badge proximamente">Próximamente</span></a>
        </div>

        <div class="list-group-item item-simple perfil-opcion">
            <a class="list-group-item-action opcion-boton opcion-proximamente icono-idioma"><strong>Idioma</strong><span class="badge proximamente">Próximamente</span></a>
        </div>

        <div class="list-group-item item-simple perfil-opcion">
            <a class="list-group-item-action opcion-boton opcion-proximamente icono-notificaciones"><strong>Notificaciones</strong><span class="badge proximamente">Próximamente</span></a>
        </div>
    </section>
    <section class="volver-arriba">

        <div>
            <a class="link-volver" href="@Url.Action("Index", "Perfil")"><strong>Volver</strong></a>
        </div>
    </section>

</main>
</body>
</html>
