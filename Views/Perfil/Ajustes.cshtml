@{
    ViewData["ClaseBody"] = "pagina-perfil";
}

<div class="perfil">
    <h1 class="perfil-titulo">Ajustes</h1>

    <section class="caja-blanca">

        <div class="perfil-opcion">
            <a class="opcion-boton opcion-proximamente icono-accesibilidad"><strong>Accesibilidad</strong><span class="proximamente">Próximamente</span></a>
        </div>

        <div class="perfil-opcion">
            <a class="opcion-boton opcion-proximamente icono-soporte"><strong>Soporte</strong><span class="proximamente">Próximamente</span></a>
        </div>

        <div class="perfil-opcion">
            <a class="opcion-boton opcion-proximamente icono-idioma"><strong>Idioma</strong><span class="proximamente">Próximamente</span></a>
        </div>

        <div class="perfil-opcion">
            <a class="opcion-boton opcion-proximamente icono-notificaciones"><strong>Notificaciones</strong><span class="proximamente">Próximamente</span></a>
        </div>
    </section>
    <section class="volver-arriba">

        <div>
            <a class="link-volver" href="@Url.Action("Index", "Perfil")"><strong>Volver</strong></a>
        </div>
    </section>

</div>
