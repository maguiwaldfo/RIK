@{
    ViewData["ClaseBody"] = "pagina-perfil";
}

<div class="perfil">
    <h1 class="perfil-titulo">Cambiar contraseña</h1>

    <section class="seccion-abierta">
        <form class="registro-form login-form capa-arriba" action="@Url.Action("CambiarContrasena", "Perfil")" method="post" onsubmit="return validarCambioContrasena()" novalidate>

            <div class="form-field">
                <label for="contrasenaActual">Contraseña actual</label>
                <input type="password" id="contrasenaActual" name="contrasenaActual" placeholder="Contraseña actual" maxlength="50" required />
                <p id="fb-contrasenaActual" class="feedback"></p>
            </div>

            <div class="form-field">
                <label for="nuevaContrasena">Nueva contraseña</label>
                <input type="password" id="nuevaContrasena" name="nuevaContrasena" placeholder="Nueva contraseña" minlength="8" maxlength="50" required />
                <p id="fb-nuevaContrasena" class="feedback"></p>
            </div>

            <div class="form-field">
                <label for="repetirContrasena">Repetir nueva contraseña</label>
                <input type="password" id="repetirContrasena" name="repetirContrasena" placeholder="Repetir nueva contraseña" maxlength="50" required />
                <p id="fb-repetirContrasena" class="feedback"></p>
            </div>

            <p class="feedback" hidden="@ViewBag.OcultarError">@ViewBag.ErrorMessage</p>

            <button type="submit" class="submit-button">Guardar contraseña</button>
        </form>

        <div class="volver-arriba">
            <a class="link-volver" href="@Url.Action("ModificarMisDatos", "Perfil")"><strong>Volver</strong></a>
        </div>
    </section>

</div>
<script src="~/js/cambiarContrasena.js"></script>
