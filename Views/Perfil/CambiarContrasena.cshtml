@{
    ViewData["ClaseBody"] = "pagina-perfil";
}

<body class="mapa-body">
<main class="perfil">
    <h1 class="perfil-titulo">Cambiar contraseña</h1>

    <section class="seccion-abierta">
        <form id="registroForm" class="login-form capa-arriba" action="@Url.Action("CambiarContrasena", "Perfil")" method="post" novalidate>

            <div class="form-field">
                <label class="form-label" for="contrasenaActual">Contraseña actual</label>
                <input type="password" id="contrasenaActual" class="form-control" name="contrasenaActual" placeholder="Contraseña actual" required />
            </div>

            <div class="form-field">
                <label class="form-label" for="nuevaContrasena">Nueva contraseña</label>
                <input type="password" id="nuevaContrasena" class="form-control" name="nuevaContrasena" placeholder="Nueva contraseña" required />
            </div>

            <div class="form-field">
                <label class="form-label" for="repetirContrasena">Repetir nueva contraseña</label>
                <input type="password" id="repetirContrasena" class="form-control" name="repetirContrasena" placeholder="Repetir nueva contraseña" required />
            </div>

            <p class="feedback" hidden="@ViewBag.OcultarError">@ViewBag.ErrorMessage</p>

            <button type="submit" class="submit-button">Guardar contraseña</button>
        </form>

        <div class="volver-arriba">
            <a class="link-volver" href="@Url.Action("ModificarMisDatos", "Perfil")"><strong>Volver</strong></a>
        </div>
    </section>

</main>
<script src="~/js/registrarse.js"></script>
</body>
</html>