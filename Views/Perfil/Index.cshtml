@{
    ViewData["Title"] = "Mi perfil";
    ViewData["ClaseBody"] = "pagina-perfil";
}

<div class="perfil">
    <h1 class="perfil-titulo perfil-titulo-avatar">Mi perfil</h1>

    <section class="caja-blanca">

        <div class="perfil-opcion">
            <a class="opcion-boton opcion-link icono-datos" href="@Url.Action("ModificarMisDatos", "Perfil")"><strong>Modificar mis datos</strong></a>
        </div>

        <div class="perfil-opcion">
            <a class="opcion-boton opcion-link icono-personalizar" href="#"><strong>Personalizar a Rik</strong></a>
        </div>

        <div class="perfil-opcion">
            <a class="opcion-boton opcion-link icono-ajustes" href="@Url.Action("Ajustes", "Perfil")"><strong>Ajustes</strong></a>
        </div>
    </section>
    <section class="caja-blanca">

        <div class="perfil-opcion">
            @* CerrarSesion solo acepta POST, por eso es un formulario y no un link *@
            <form class="cerrarsesion-form" method="post" action="@Url.Action("CerrarSesion", "Perfil")">
                <button type="submit" class="boton-link opcion-boton cerrarsesion-boton"><strong>Cerrar sesión</strong></button>
            </form>
        </div>
    </section>

</div>
