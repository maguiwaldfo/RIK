@{
    ViewData["ClaseBody"] = "pagina-perfil";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Inicio</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="mapa-body">
<main class="perfil">
    <h1 class="perfil-titulo perfil-titulo-avatar">Mi perfil</h1>

    <section class="list-group caja-blanca">

        <div class="list-group-item item-simple perfil-opcion">
            <a class="list-group-item-action opcion-boton opcion-link icono-datos" href="@Url.Action("ModificarMisDatos", "Perfil")"><strong>Modificar mis datos</strong></a>
        </div>

        <div class="list-group-item item-simple perfil-opcion">
            <a class="list-group-item-action opcion-boton opcion-link icono-personalizar" href="#"><strong>Personalizar a Rik</strong></a>
        </div>

        <div class="list-group-item item-simple perfil-opcion">
            <a class="list-group-item-action opcion-boton opcion-link icono-ajustes" href="@Url.Action("Ajustes", "Perfil")"><strong>Ajustes</strong></a>
        </div>
    </section>
    <section class="list-group caja-blanca">

        <div class="list-group-item item-simple perfil-opcion">
            @* CerrarSesion solo acepta POST, por eso es un formulario y no un link *@
            <form class="cerrarsesion-form" method="post" action="@Url.Action("CerrarSesion", "Perfil")">
                <button type="submit" class="boton-link list-group-item-action opcion-boton cerrarsesion-boton"><strong>Cerrar sesión</strong></button>
            </form>
        </div>
    </section>

</main>
</body>
</html>
