@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RIK - Inicio</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="mapa-body">
<main>

    <section>
    
            <form id="registroForm" class="login-form" action="@Url.Action("ModificarMisDatos", "Perfil")" method="post" onsubmit="return registrarUsuario()" novalidate>

                <div class="form-field">
                    <input type="text" id="nombre" name="nombre" value="@(Context.Session.GetString("Nombre") ?? "")" />
                    <p id="fb-nombre" class="feedback"></p>
                </div>

                <div class="form-field">
                    <input type="email" id="email" name="email" value="@(Context.Session.GetString("Email") ?? "")" />
                    <p id="fb-email" class="feedback"></p>
                </div>

                <div class="form-field">
                    <input type="text" id="nombreUsuario" name="nombreUsuario" value="@(Context.Session.GetString("NombreUsuario") ?? "")" />
                    <p id="fb-nombreUsuario" class="feedback"></p>
                    <p id="fb-servidor" class="feedback">@ViewBag.ErrorMessage</p>
                </div>

                <div class="form-field">
                    <input type="password" id="contrasena" name="contraseña" placeholder="Nueva contraseña (vacío = no cambiar)" data-opcional="true" />
                    <p id="fb-contrasena" class="feedback"></p>
                </div>

                <button type="submit" class="submit-button">Guardar cambios</button>
            </form>
    </section>
    <section>
    
        <div>
            <a href="@Url.Action("Index", "Perfil")"><strong>Volver</strong></a>
        </div>
    </section>

</main>
<script src="~/js/registrarse.js"></script>
</body>
</html>