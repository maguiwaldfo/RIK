@{
    ViewData["ClaseBody"] = "pagina-perfil";
}

<div class="perfil">
    <h1 class="perfil-titulo">Mis datos</h1>

    <section class="seccion-abierta">
    
            <form class="registro-form login-form capa-arriba" action="@Url.Action("ModificarDatos", "Perfil")" method="post" onsubmit="return registrarUsuario()" novalidate>

                <div class="form-field campo-nombre">
                    <input type="text" id="nombre" name="nombre" value="@ViewBag.Nombre" />
                    <p id="fb-nombre" class="feedback"></p>
                </div>

                <div class="form-field campo-email">
                    <input type="email" id="email" name="email" value="@ViewBag.Email" />
                    <p id="fb-email" class="feedback"></p>
                </div>

                <div class="form-field campo-usuario">
                    <input type="text" id="nombreUsuario" name="nombreUsuario" value="@ViewBag.NombreUsuario" />
                    <p id="fb-nombreUsuario" class="feedback"></p>
                    <p id="fb-servidor" class="feedback">@ViewBag.ErrorMessage</p>
                </div>

                <button type="submit" class="submit-button">Guardar cambios</button>
            </form>

            <div class="caja-blanca">
            <a class="opcion-boton opcion-link icono-contrasena" href="@Url.Action("CambiarContrasena", "Perfil")"><strong>Cambiar Contraseña</strong></a>
            </div>

    </section>
    <section class="volver-arriba seccion-abierta">
    
        <div class="volver-arriba">
            <a class="link-volver" href="@Url.Action("Index", "Perfil")"><strong>Volver</strong></a>
        </div>
    </section>

</div>
<script src="~/js/registrarse.js"></script>
