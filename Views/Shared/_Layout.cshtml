@{
    var nombreUsuario = Context.Request.Cookies["NombreUsuario"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RIK</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RIK.styles.css" asp-append-version="true" />
</head>
<body>
@{
    if(string.IsNullOrEmpty(nombreUsuario)) {
        <header class="encabezado">
            <a class="marca" href="#inicio">
                <img src="@Url.Content("~/imagenes/rik-logo.png")" alt="Logo de RIK">
                <span>RIK</span>
            </a>

        <nav class="nav">
            <a href="#quienes-somos">Quienes somos</a>
            <a href="#nuestra-mision">Nuestra misión</a>
            <a href="#logros">Logros</a>
            <a href="#galeria">Galería</a>
        </nav>

        <a class="boton-login" href="@Url.Action("Index", "Login")">
            Inicia Sesión
        </a>
    </header>
    }
   else {
    <header class="mapa-header">
        <div class="mapa-marca">
            <img class="brand-mark" src="/images/Logo rik (1).png" alt="Logo RIK">
        </div>

        <nav class="mapa-nav">
            <a href="@Url.Action("Index", "Home")">Inicio</a>
            <a href="#">Liga</a>
            <a href="@Url.Action("Index", "Perfil")">Perfil</a>
        </nav>

        <a class="mapa-perfil" href="#" aria-label="Usuario">👤</a>
    </header>

    }
}
    <div class="page-shell">
        <main role="main" class="pb-3 page-main">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
</body>
</html>
