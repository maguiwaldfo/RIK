<!DOCTYPE html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RIK</title>
    <script type="importmap"></script>
    <!-- Fuentes de los componentes de Figma: Space Grotesk (RIK), Ubuntu (menú) y Poppins 500 (botón) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500&family=Space+Grotesk:wght@400&family=Ubuntu:wght@500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RIK.styles.css" asp-append-version="true" />
</head>
<div lang="es" class="@ViewData["ClaseBody"]">

@if (ViewData["HeaderVolver"] != null)
{
    @*  Componente de Figma: header con "Volver"  *@
    <header class="hf hf-volver">
<div class="hf-lienzo" style="width: 1280px; height: 99px; position: relative">
  <div class="hf-fondo" style="width: 1280px; height: 99px; left: 0px; top: 0px; position: absolute; background: #0A4D28"></div>
  <a href="@Url.Content("~/")">
    <div class="hf-texto" style="width: 96px; height: 87px; left: 109px; top: 12px; position: absolute; color: white; font-size: 64px; font-family: Space Grotesk; font-weight: 400; word-wrap: break-word">RIK</div>
    <img class="hf-logo brand-logo" style="width: 78px; height: 77px; left: 16px; top: 17px; position: absolute; border-radius: 50px" src="@Url.Content("~/imagenes/rik-logo.png")" alt="Logo de RIK" />
  </a>
  <div class="hf-accion" style="width: 202px; height: 58px; left: 1055px; top: 21px; position: absolute; justify-content: flex-start; align-items: flex-start; display: inline-flex">
    <a href="@(ViewData["UrlVolver"] ?? Url.Content("~/"))">
      <div data-property-1="Rest" data-property-2="Size small" style="width: 202px; height: 58px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; background: #FFD700; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: flex">
        <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 18px; font-family: Poppins; font-weight: 500; line-height: 22px; word-wrap: break-word">Volver</div>
      </div>
    </a>
  </div>
</div>
    </header>
}
else if (string.IsNullOrEmpty(Context.Session.GetString("NombreUsuario")))
{
    @*  Componente de Figma: header sin sesión  *@
    <header class="hf hf-sinsesion">
<div class="hf-lienzo" style="width: 1280px; height: 99px; position: relative">
  <div class="hf-marco" style="width: 1280px; height: 99px; left: 0px; top: 0px; position: absolute; background: white">
    <div class="hf-fondo" style="width: 1280px; left: 0px; top: 0px; position: absolute; flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 10px; display: inline-flex">
      <div style="align-self: stretch; height: 99px; background: #0A4D28"></div>
    </div>
    <div class="hf-accion" style="left: 1038px; top: 21px; position: absolute; justify-content: flex-start; align-items: flex-start; display: inline-flex">
      <a href="@Url.Action("Index", "Login")">
        <div data-property-1="Rest" data-property-2="Size small" style="width: 202px; height: 58px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; background: #FFD700; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: flex">
          <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 18px; font-family: Poppins; font-weight: 500; line-height: 22px; word-wrap: break-word">Inicia Sesión</div>
        </div>
      </a>
    </div>
    <a href="#inicio">
      <div class="hf-texto" style="width: 96px; height: 87px; left: 125px; top: 9px; position: absolute; color: white; font-size: 64px; font-family: Space Grotesk; font-weight: 400; word-wrap: break-word">RIK</div>
      <img class="hf-logo brand-logo" style="width: 78px; height: 77px; left: 32px; top: 14px; position: absolute; border-radius: 50px" src="@Url.Content("~/imagenes/rik-logo.png")" alt="Logo de RIK" />
    </a>
    <div class="hf-menu" style="width: 575px; height: 40px; left: 353px; top: 33px; position: absolute">
      <a href="#quienes-somos">
        <div data-property-1="Rest" data-property-2="Size small" style="width: 131px; height: 40px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; left: 0px; top: 0px; position: absolute; background: #FFEA00; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
          <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 16px; font-family: Ubuntu; font-weight: 500; line-height: 20px; word-wrap: break-word">Quienes somos</div>
        </div>
      </a>
      <a href="#nuestra-mision">
        <div data-property-1="Rest" data-property-2="Size small" style="width: 131px; height: 40px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; left: 148px; top: 0px; position: absolute; background: #FFEA00; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
          <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 16px; font-family: Ubuntu; font-weight: 500; line-height: 20px; word-wrap: break-word">Nuestra misión</div>
        </div>
      </a>
      <a href="#logros">
        <div data-property-1="Rest" data-property-2="Size small" style="width: 131px; height: 40px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; left: 296px; top: 0px; position: absolute; background: #FFEA00; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
          <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 16px; font-family: Ubuntu; font-weight: 500; line-height: 20px; word-wrap: break-word">Logros</div>
        </div>
      </a>
      <a href="#galeria">
        <div data-property-1="Rest" data-property-2="Size small" style="width: 131px; height: 40px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; left: 444px; top: 0px; position: absolute; background: #FFEA00; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
          <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 16px; font-family: Ubuntu; font-weight: 500; line-height: 20px; word-wrap: break-word">Galería</div>
        </div>
      </a>
    </div>
  </div>
</div>
    </header>
}
else
{
    @*  Componente de Figma: header con sesión *@
    <header class="hf hf-consesion">
<div class="hf-lienzo" style="width: 1280px; height: 99px; position: relative">
  <div class="hf-fondo" style="width: 1280px; height: 99px; left: 0px; top: 0px; position: absolute">
    <div style="width: 1280px; height: 99px; left: 0px; top: 0px; position: absolute; background: #0A4D28"></div>
  </div>
  <a href="@Url.Action("Index", "Perfil")" aria-label="Usuario">
    <div class="hf-usuario" style="width: 66px; height: 66px; left: 1182px; top: 13px; position: absolute; border-radius: 9999px; background: #FFE500; display: flex; align-items: center; justify-content: center; font-size: 40px">👤</div>
  </a>
  <a href="@Url.Action("IndexInicio", "Inicio")">
    <div class="hf-texto" style="width: 96px; height: 80px; left: 114px; top: 9px; position: absolute; color: white; font-size: 64px; font-family: Space Grotesk; font-weight: 400; word-wrap: break-word">RIK</div>
    <img class="hf-logo brand-logo" style="width: 78px; height: 77px; left: 28px; top: 10px; position: absolute; border-radius: 39px" src="@Url.Content("~/imagenes/rik-logo.png")" alt="Logo RIK" />
  </a>
  <div class="hf-menu" style="width: 431px; height: 40px; left: 482px; top: 30px; position: absolute">
    <a href="@Url.Action("IndexInicio", "Inicio")">
      <div data-property-1="Rest" data-property-2="Size small" style="width: 131px; height: 40px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; left: 0px; top: 0px; position: absolute; background: #FFEA00; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
        <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 16px; font-family: Ubuntu; font-weight: 500; line-height: 20px; word-wrap: break-word">Inicio</div>
      </div>
    </a>
    <a href="@Url.Action("Index", "Liga")">
      <div data-property-1="Rest" data-property-2="Size small" style="width: 131px; height: 40px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; left: 150px; top: 0px; position: absolute; background: #FFEA00; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
        <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 16px; font-family: Ubuntu; font-weight: 500; line-height: 20px; word-wrap: break-word">Liga</div>
      </div>
    </a>
    <a href="@Url.Action("Index", "Perfil")">
      <div data-property-1="Rest" data-property-2="Size small" style="width: 131px; height: 40px; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; left: 300px; top: 0px; position: absolute; background: #FFEA00; overflow: hidden; border-radius: 7px; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
        <div style="text-align: center; justify-content: center; display: flex; flex-direction: column; color: black; font-size: 16px; font-family: Ubuntu; font-weight: 500; line-height: 20px; word-wrap: break-word">Perfil</div>
      </div>
    </a>
  </div>
</div>
    </header>
}


    <script>
        (function () {
            var raiz = document.documentElement;
            function ajustarHeader() {
                raiz.style.setProperty('--hf-zoom', Math.min(1, raiz.clientWidth / 1280));
                var header = document.querySelector('.hf');
                if (header) { raiz.style.setProperty('--alto-header', header.offsetHeight + 'px'); }
            }
            ajustarHeader();
            window.addEventListener('resize', ajustarHeader);
        })();
    </script>

    <div class="page-shell">
        <main role="main" class="page-main @ViewData["ClaseMain"]">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</div>