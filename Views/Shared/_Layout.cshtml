<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RIK</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RIK.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["ClaseBody"]">

@if (string.IsNullOrEmpty(Context.Session.GetString("NombreUsuario")))
{
    <header class="encabezado navbar">
        <a class="marca navbar-brand" href="#inicio">
            <img src="@Url.Content("~/imagenes/rik-logo.png")" alt="Logo de RIK">
            <span>RIK</span>
        </a>

        <nav class="nav">
            <a class="nav-link" href="#quienes-somos">Quienes somos</a>
            <a class="nav-link" href="#nuestra-mision">Nuestra misión</a>
            <a class="nav-link" href="#logros">Logros</a>
            <a class="nav-link" href="#galeria">Galería</a>
        </nav>

        <a class="boton-login" href="@Url.Action("Index", "Login")">
            Inicia Sesión
        </a>
    </header>
}
else
{
    <header class="mapa-header navbar">
        <a class="mapa-marca navbar-brand" href="@Url.Action("IndexInicio", "Inicio")">
            <img class="brand-mark" src="~/imagenes/rik-logo.png" alt="Logo RIK">
        </a>

        <nav class="mapa-nav navbar-nav">
            <a class="nav-link" href="@Url.Action("IndexInicio", "Inicio")">Inicio</a>
            <a class="nav-link" href="@Url.Action("Index", "Liga")">Liga</a>
            <a class="nav-link" href="@Url.Action("Index", "Perfil")">Perfil</a>
        </nav>

        <a class="mapa-perfil" href="@Url.Action("Index", "Perfil")" aria-label="Usuario">👤</a>
    </header>
}

    <div class="page-shell">
        <main role="main" class="pb-3 page-main @ViewData["ClaseMain"]">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>